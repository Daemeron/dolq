{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.daemeron.dolq",
  "productName": "Dolq",
  "directories": {
    "buildResources": "resources"
  },
  "files": [
    "out/**"
  ],
  "extraResources": [
    {
      "from": "resources",
      "to": "resources",
      "filter": ["icon.png", "icons/32x32.png", "trayIconTemplate*.png"]
    },
    {
      "from": "backend/bin",
      "to": "bin"
    }
  ],
  // The update feed is the latest release's own assets (latest.yml and friends), so no publish step is needed.
  "publish": [
    {
      "provider": "generic",
      "url": "https://github.com/Daemeron/dolq/releases/latest/download"
    }
  ],
  "mac": {
    // Ad-hoc signing ("-"): there is no paid Apple account, but the bundle still has to be signed as itself, with its
    // resources sealed and its own identifier. Without a signature of its own macOS cannot tell the app apart from
    // any other Electron app, and refuses it the local network (EHOSTUNREACH). Hardened runtime stays off: with an
    // ad-hoc identity it would reject Electron's own frameworks.
    "identity": "-",
    "hardenedRuntime": false,
    // macOS asks before an app talks to other machines on the local network, and only an app that says why can be
    // asked. Dolq reaches a backend on a NAS or a server, so without this it is refused with "no route to host".
    "extendInfo": {
      "NSLocalNetworkUsageDescription": "Dolq connects to a Dolq backend running on your local network, such as one on a NAS."
    },
    "target": [
      "dmg",
      "zip"
    ]
  },
  "win": {
    "executableName": "dolq",
    "target": [
      "nsis"
    ]
  },
  // No spaces: GitHub renames a spaced asset, and latest.yml has to name the file exactly as it is uploaded.
  "nsis": {
    "artifactName": "${productName}-Setup-${version}.${ext}"
  },
  "linux": {
    "target": [
      "AppImage",
      "deb"
    ],
    "category": "Network"
  }
}