{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.daemeron.dolq",
  "productName": "Dolq",
  "directories": {
    "buildResources": "resources"
  },
  "files": [
    "out/**"
  ],
  "extraResources": [
    {
      "from": "resources",
      "to": "resources",
      "filter": ["icon.png", "icons/32x32.png", "trayIconTemplate*.png"]
    },
    {
      "from": "backend/bin",
      "to": "bin"
    }
  ],
  // The update feed is the latest release's own assets (latest.yml and friends), so no publish step is needed.
  "publish": [
    {
      "provider": "generic",
      "url": "https://github.com/Daemeron/dolq/releases/latest/download"
    }
  ],
  "mac": {
    "sign": {
      "identity": "-",
      "hardenedRuntime": false
    },
    "target": [
      "dmg",
      "zip"
    ]
  },
  "win": {
    "executableName": "dolq",
    "target": [
      "nsis"
    ]
  },
  // No spaces: GitHub renames a spaced asset, and latest.yml has to name the file exactly as it is uploaded.
  "nsis": {
    "artifactName": "${productName}-Setup-${version}.${ext}"
  },
  "linux": {
    "target": [
      "AppImage",
      "deb"
    ],
    "category": "Network"
  }
}