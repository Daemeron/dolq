{
  "name": "dolq",
  "version": "0.5.0",
  "description": "A Discord-like IRC client",
  "author": {
    "email": "daemeron@icloud.com",
    "name": "Daemeron",
    "url": "https://github.com/Daemeron"
  },
  "main": "out/main/index.js",
  "scripts": {
    "frontend:dev": "electron-vite dev",
    "frontend:build": "electron-vite build",
    "frontend:test": "vitest run",
    "frontend:test:dev": "vitest",
    "frontend:test:coverage": "vitest run --coverage",
    "frontend:e2e": "electron-vite build && playwright test",
    "frontend:typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "frontend:lint": "biome check .",
    "frontend:lint:fix": "biome check --write .",
    "backend:build": "go build -C backend -o bin/ ./cmd/dolqd",
    "backend:dev": "node backend/scripts/dev.mjs",
    "backend:test": "go -C backend test ./...",
    "backend:test:coverage": "cd backend && ./scripts/check-coverage.sh",
    "backend:test:dev": "go -C backend run github.com/air-verse/air@v1.67.4 -c .air.test.toml",
    "run": "electron-vite preview",
    "package": "npm run backend:build && npm run frontend:build && electron-builder"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-virtual": "^3.14.9",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "electron": "^42.11.14",
    "electron-builder": "^26.0.0",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.0.0",
    "vitest": "^4.1.9",
    "zustand": "^5.0.14"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true,
    "electron-winstaller": true,
    "fsevents": true
  }
}
